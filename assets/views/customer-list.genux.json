{
  "schema": "aix.genux/1.0",
  "view": {
    "id": "3001",
    "code": "customer.list",
    "revision": 1,
    "kind": "view"
  },
  "catalog": {
    "id": "aix.core",
    "version": 2,
    "checksum": "sha256:a1b2c3d4e5f6789012345678901234567890123456789012345678901234abcd"
  },
  "root": "root",
  "state": {
    "customers": {
      "list": [
        {
          "id": "1001",
          "name": "Mya Chen",
          "type": "Business",
          "email": "mya.chen@example.com",
          "revenue": "$125,000",
          "status": "Active"
        },
        {
          "id": "1002",
          "name": "Alex Rivera",
          "type": "Retail",
          "email": "alex.rivera@example.com",
          "revenue": "$45,000",
          "status": "Active"
        },
        {
          "id": "1003",
          "name": "Jordan Smith",
          "type": "Business",
          "email": "jordan.smith@example.com",
          "revenue": "$89,000",
          "status": "Inactive"
        },
        {
          "id": "1004",
          "name": "Taylor Kim",
          "type": "Internal",
          "email": "taylor.kim@example.com",
          "revenue": "$0",
          "status": "Active"
        },
        {
          "id": "1005",
          "name": "Morgan Lee",
          "type": "Retail",
          "email": "morgan.lee@example.com",
          "revenue": "$62,000",
          "status": "Active"
        }
      ]
    },
    "ui": {
      "loading": false
    }
  },
  "actions": {
    "selectCustomer": {
      "capability": "customer.select",
      "args": {
        "customerId": {"$bind": {"source": "item", "path": "/data/id"}},
        "customerName": {"$bind": {"source": "item", "path": "/data/name"}}
      }
    }
  },
  "nodes": [
    {
      "id": "root",
      "component": "Column",
      "version": 1,
      "props": {
        "gap": 16,
        "crossAxisAlignment": "stretch",
        "mainAxisSize": "max"
      },
      "slots": {
        "children": ["header", "expandedCollection"]
      }
    },
    {
      "id": "header",
      "component": "Text",
      "version": 1,
      "props": {
        "text": "Customer Directory",
        "style": "headlineMedium"
      }
    },
    {
      "id": "expandedCollection",
      "component": "Expanded",
      "version": 1,
      "slots": {
        "child": ["collectionView"]
      }
    },
    {
      "id": "collectionView",
      "component": "CollectionView",
      "version": 1,
      "props": {
        "itemKey": "id",
        "layout": "list",
        "itemHeight": 88,
        "padding": 0,
        "emptyMessage": "No customers found"
      },
      "bind": {
        "items": "/customers/list",
        "loading": "/ui/loading"
      },
      "events": {
        "itemInvoked": "selectCustomer"
      },
      "slots": {
        "itemTemplate": ["customerListItem"]
      }
    },
    {
      "id": "customerListItem",
      "component": "Card",
      "version": 1,
      "props": {
        "padding": 16
      },
      "slots": {
        "content": ["itemLayout"]
      }
    },
    {
      "id": "itemLayout",
      "component": "Row",
      "version": 1,
      "props": {
        "gap": 16,
        "mainAxisSize": "max",
        "crossAxisAlignment": "center"
      },
      "slots": {
        "children": ["itemInfo", "itemRevenue"]
      }
    },
    {
      "id": "itemInfo",
      "component": "Column",
      "version": 1,
      "props": {
        "gap": 4,
        "mainAxisSize": "min",
        "crossAxisAlignment": "start"
      },
      "slots": {
        "children": ["itemName", "itemEmail", "itemType"]
      }
    },
    {
      "id": "itemName",
      "component": "Text",
      "version": 1,
      "props": {
        "style": "titleMedium"
      },
      "bind": {
        "text": {"source": "item", "path": "/data/name"}
      }
    },
    {
      "id": "itemEmail",
      "component": "Text",
      "version": 1,
      "props": {
        "style": "bodySmall"
      },
      "bind": {
        "text": {"source": "item", "path": "/data/email"}
      }
    },
    {
      "id": "itemType",
      "component": "Text",
      "version": 1,
      "props": {
        "style": "labelSmall"
      },
      "bind": {
        "text": {"source": "item", "path": "/data/type"}
      }
    },
    {
      "id": "itemRevenue",
      "component": "Column",
      "version": 1,
      "props": {
        "gap": 2,
        "mainAxisSize": "min",
        "crossAxisAlignment": "end"
      },
      "slots": {
        "children": ["revenueLabel", "revenueValue"]
      }
    },
    {
      "id": "revenueLabel",
      "component": "Text",
      "version": 1,
      "props": {
        "text": "Revenue",
        "style": "labelSmall"
      }
    },
    {
      "id": "revenueValue",
      "component": "Text",
      "version": 1,
      "props": {
        "style": "titleMedium"
      },
      "bind": {
        "text": {"source": "item", "path": "/data/revenue"}
      }
    }
  ]
}
